<?xml version="1.0" encoding="utf-8"?>
<!-- Фон иконки: мягкий диагональный градиент фирменного зелёного.
     Раньше был плоский цвет — с градиентом иконка не сливается с
     однотонными соседями по доку и выглядит «приложением», а не ярлыком. -->
