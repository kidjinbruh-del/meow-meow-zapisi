# Нормализация переводов строк: скрипты должны остаться LF, иначе CI не запустит gradlew.
* text=auto

*.kt text eol=lf
*.kts text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.properties text eol=lf
*.pro text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.jar binary
*.jks binary
